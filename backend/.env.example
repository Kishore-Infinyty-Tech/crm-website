# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
APP_URL=http://localhost:3000

# Optional: Brevo email (otherwise emails print in the terminal)
# BREVO_SMTP_USER=
# BREVO_SMTP_KEY=
# DEFAULT_FROM_EMAIL=CRM <you@your-verified-sender>

# Optional: Backblaze B2 file storage (otherwise files go to backend/media)
# B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# B2_KEY_ID=
# B2_APP_KEY=
# B2_BUCKET=

# Optional: protects /api/cron/reminders
# CRON_SECRET=
